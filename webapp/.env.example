APP_NAME="Rhydo Fleet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8130
APP_VERSION=0.1.0
APP_BUILD=1

# The super-admin console lives at /<this>/login instead of a guessable /admin.
# Choose something private, e.g. ctl-x7k2pq.
PLATFORM_PATH=ctl
# Leave empty: the console setting decides whether the sign-in picture is always shown.
# CAPTCHA_MODE=after_failures
TRIAL_DAYS=14

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MariaDB from XAMPP on the laptop; MySQL 8 in production.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleet
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# One-time codes by SMS / WhatsApp (decision D21). "log" writes the code to
# the application log instead of sending it — for development only.
OTP_SMS_DRIVER=log

# Push to the phone apps (M20): fcm once the Firebase project's service-account JSON is on the server
# (outside the repository); log writes each push to storage/logs; none switches pushes off.
PUSH_DRIVER=log
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Headless Chromium for PDFs (blueprint 10 §10). Empty = look in the usual places.
# CHROME_PATH=
